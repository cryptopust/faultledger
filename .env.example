# Example only. Do not use production secrets or real financial/customer data.
# Copy to .env for Compose; replace CHANGE_ME_LOCAL_ONLY with faultledger_local_only.
# The API rejects the unchanged placeholder. This is local infrastructure, not production.
# Do not overwrite an existing .env; retain its local settings.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=faultledger
POSTGRES_USER=faultledger_dev
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
API_PORT=8080
TOXIPROXY_API_PORT=8474
SIMULATED_CONSUMER_PORT=8081
# Compose uses POSTGRES_* to configure its database and API connection string.
# Native dotnet run does NOT load .env: set ConnectionStrings__Postgres explicitly.
# Example: Host=localhost;Port=5432;Database=faultledger;Username=faultledger_dev;Password=faultledger_local_only
